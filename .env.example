# Supabase (all DB access goes through the service role on the server)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin (HTTP Basic Auth for /admin/*)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Resend
RESEND_API_KEY=
# Sender shown in transactional emails. Must be a verified Resend domain in
# production. Defaults to Resend's shared sender (only delivers to the account
# owner — fine for local dev, NOT for prod).
RESEND_FROM_EMAIL="Bachata Vienna <onboarding@resend.dev>"
INSTRUCTOR_EMAIL=dusaliev.marat@gmail.com
CONTACT_EMAIL=
# Where guests' replies to booking emails go (optional; defaults to
# PUBLIC_CONTACT_EMAIL in lib/constants.ts). Needed because the sender above is
# a no-reply address.
REPLY_TO_EMAIL=dusaliev.marat@gmail.com

# Upstash Redis (optional) — shares form rate limits across all Vercel
# instances. Without it each instance limits on its own. Free tier is enough.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL (sitemap, OG metadata, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
